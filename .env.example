# Optional for writing; required for GPT Image backgrounds.
# Never commit your real key.
OPENAI_API_KEY=

# Default writing path: reuse `codex login` (ChatGPT OAuth).
INSTAGRAM_TEXT_PROVIDER=codex
INSTAGRAM_CODEX_MODEL=gpt-5.6-terra
INSTAGRAM_CODEX_EFFORT=medium
INSTAGRAM_CODEX_TIMEOUT_MS=600000

# Optional direct OpenAI API text-provider overrides.
INSTAGRAM_OPENAI_MODEL=gpt-5.6
INSTAGRAM_OPENAI_EFFORT=medium
INSTAGRAM_TONE=casual
INSTAGRAM_OPENAI_TIMEOUT_MS=300000
INSTAGRAM_IMAGE_MODEL=gpt-image-2
INSTAGRAM_IMAGE_SIZE=1024x1536
INSTAGRAM_IMAGE_MOOD=dark
INSTAGRAM_STUDIO_PORT=5273
